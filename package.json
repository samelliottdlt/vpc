{
  "name": "vpc",
  "version": "1.0.0",
  "description": "Things that I run in a vpc",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --build",
    "clean": "tsc --build --clean",
    "typecheck": "tsc --build",
    "start": "npm start --workspace @vpc/gateway",
    "lint": "eslint .",
    "test": "npm run build && npm test --workspaces --if-present",
    "prettier": "prettier --write .",
    "prettier:check": "prettier --check ."
  },
  "author": "",
  "license": "ISC",
  "workspaces": [
    "packages/api",
    "packages/current-time",
    "packages/server"
  ],
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^26.1.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^9.39.5",
    "prettier": "^3.9.5",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.65.0"
  }
}
